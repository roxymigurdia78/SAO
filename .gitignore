# ==================================================
# MVL / 実験生成物
# ==================================================

# リポジトリ直下の実験結果
/runs/

# mvl-skeleton内の実験結果
/mvl-skeleton/runs/

# 研究用の画像データセット（コード・集計結果は残す）
/research/data_256/

# MVLの生成画像
/mvl-skeleton/images/
/mvl-skeleton/scene/capture*/
**/.front_offsets_backup_*.json
# Python生成物
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# 旧いルート直下の検品表(実行時はscene/assets/0824版を使用)
/assets_inventory.json


# ==================================================
# 機密情報
# ==================================================

.env
.env.*
!.env.example
*api_key*
*API_KEY*


# ==================================================
# 画像・重い3Dアセット
# ==================================================

# PNGをすべて除外
*.png
# シェルテクスチャ機能の最小テスト素材だけはリポジトリに含める
!/mvl-skeleton/scene/test_assets/shell/study_seed1/*.png

# GLBをすべて除外
*.glb


